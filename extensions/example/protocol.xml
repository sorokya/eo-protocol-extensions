<?xml version="1.0" encoding="UTF-8"?>
<!--
  Example extension: adds an ExampleRarity enum and a new PacketFamily value,
  plus a request/reply packet pair.

  Root-level definitions (enums, structs, packets for non-net traffic) go here.
-->
<protocol>
    <!-- New top-level enum — no 'extend' means "must not already exist" -->
    <enum name="ExampleRarity" type="char">
        <value name="Common">0</value>
        <value name="Uncommon">1</value>
        <value name="Rare">2</value>
        <value name="Legendary">3</value>
    </enum>

    <!-- Append a new value to the existing PacketFamily enum -->
    <enum name="PacketFamily" extend="append">
        <value name="Example">240</value>
    </enum>
</protocol>
